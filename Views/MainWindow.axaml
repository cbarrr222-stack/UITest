<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WidgetDashboard.ViewModels"
        xmlns:views="using:WidgetDashboard.Views"
        x:Class="WidgetDashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Widget Dashboard"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*" Margin="20">

    <!-- Title Bar -->
    <Border Grid.Row="0" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <TextBlock Text="&#x1F4CB;" FontSize="28" VerticalAlignment="Center"/>
        <TextBlock Text="Widget Dashboard" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"
                   VerticalAlignment="Center"/>
        <Border Background="#22C55E" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                Margin="8,0,0,0">
          <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Widget Grid: Weather + ProgressBar on top, SoundCloud on bottom -->
    <Grid Grid.Row="1" RowDefinitions="*,*" ColumnDefinitions="*,*">

      <!-- Weather Widget (Top Left) -->
      <views:WeatherWidget Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                            DataContext="{Binding Weather}"/>

      <!-- Progress Bar Widget (Top Right) -->
      <views:ProgressBarWidget Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"
                                DataContext="{Binding ProgressBar}"/>

      <!-- SoundCloud Widget (Bottom, spanning both columns) -->
      <views:SoundCloudWidget Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                               DataContext="{Binding SoundCloud}"/>

    </Grid>
  </Grid>
</Window>
