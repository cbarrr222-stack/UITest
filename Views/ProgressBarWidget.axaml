<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WidgetDashboard.ViewModels"
             x:Class="WidgetDashboard.Views.ProgressBarWidget"
             x:DataType="vm:ProgressBarViewModel">

  <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

      <!-- Header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
        <TextBlock Text="&#x1F4CA;" FontSize="22"/>
        <TextBlock Text="Progress Cycler" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding CycleText}" FontSize="14" Foreground="#64748B"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>

      <!-- Big percentage display -->
      <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="72" FontWeight="Bold"
                 Foreground="{Binding ProgressColor}" HorizontalAlignment="Center"
                 Margin="0,8,0,16"/>

      <!-- Progress bar using built-in ProgressBar control -->
      <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                   Height="28" CornerRadius="14"
                   Foreground="{Binding ProgressColor}"
                   Background="#0F172A"
                   Margin="0,0,0,8"/>

      <!-- Color info -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                  Margin="0,8,0,16" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="14" Height="14" CornerRadius="7" Background="{Binding ProgressColor}"/>
          <TextBlock Text="Current" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="&#x27A1;" Foreground="#475569" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="14" Height="14" CornerRadius="7" Background="{Binding NextColor}"/>
          <TextBlock Text="Next" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Speed display -->
      <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,0,0,12"
                 FontSize="14" Foreground="#94A3B8">
        <Run Text="Speed: "/><Run Text="{Binding Speed}"/><Run Text="x"/>
      </TextBlock>

      <!-- Controls -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Padding="14,8" FontSize="12"
                Command="{Binding TogglePauseCommand}"
                Background="#3B82F6" Foreground="White" CornerRadius="10">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="&#x23EF;&#xFE0F;" VerticalAlignment="Center"/>
            <TextBlock Text="Pause/Play" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Content="-" Padding="14,8" FontSize="14" FontWeight="Bold"
                Command="{Binding DecreaseSpeedCommand}"
                Background="#334155" Foreground="#CBD5E1" CornerRadius="10"/>
        <Button Content="+" Padding="14,8" FontSize="14" FontWeight="Bold"
                Command="{Binding IncreaseSpeedCommand}"
                Background="#334155" Foreground="#CBD5E1" CornerRadius="10"/>
        <Button Padding="14,8" FontSize="12"
                Command="{Binding ResetCommand}"
                Background="#EF4444" Foreground="White" CornerRadius="10">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="&#x1F504;" VerticalAlignment="Center"/>
            <TextBlock Text="Reset" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
